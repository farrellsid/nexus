{
  "name": "nexus-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "generate:api": "openapi-typescript ../../contracts/openapi.json -o src/generated/api.ts",
    "format": "prettier --write src --ignore-path .prettierignore",
    "format:check": "prettier --check src --ignore-path .prettierignore",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "cesium": "1.138.0",
    "d3-geo": "^3.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "^7.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-cesium": "^1.2.23"
  }
}
