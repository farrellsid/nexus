{
  "name": "gods-eye-view",
  "private": true,
  "version": "0.1.1",
  "description": "A real-time intelligence console for planet Earth \u2014 photorealistic 3D globe, live aircraft/ships/satellites/earthquakes/CCTV, and hands-free voice control. Runs in a browser.",
  "type": "module",
  "license": "MIT",
  "author": "Bilawal Sidhu",
  "homepage": "https://github.com/bilawalsidhu/gods-eye-view#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bilawalsidhu/gods-eye-view.git"
  },
  "bugs": {
    "url": "https://github.com/bilawalsidhu/gods-eye-view/issues"
  },
  "engines": {
    "node": ">=24.14.0 <25 || >=26 <27"
  },
  "keywords": [
    "cesium",
    "3d-globe",
    "geospatial",
    "osint",
    "spatial-intelligence",
    "photorealistic-3d-tiles",
    "adsb",
    "ais",
    "satellites",
    "voice-control",
    "openai-realtime",
    "visualization"
  ],
  "scripts": {
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/run-unit-tests.mjs",
    "check:boundaries": "node scripts/check-import-directions.mjs && node scripts/check-package-boundaries.mjs",
    "check:engine": "node scripts/nexus-check-engine.mjs",
    "check:dead": "node scripts/nexus-dead-modules.mjs --strict",
    "e2e": "playwright test",
    "check:step": "npm run format:check && npm run typecheck && npm run check:generated && npm test && npm run check:config && npm run check:boundaries && npm run check:dead && npm run check:engine && npm run e2e",
    "check:config": "node scripts/nexus-prune-config.mjs --check",
    "typecheck": "tsc --noEmit",
    "generate": "node scripts/generate-oil-stops.mjs",
    "check:generated": "node scripts/generate-oil-stops.mjs --check"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "cesium": "^1.124.0",
    "egm96-universal": "^1.1.1",
    "mgrs": "^2.1.0",
    "pbf": "^5.1.2",
    "satellite.js": "^6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "prettier": "3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-cesium": "^1.2.23",
    "ws": "^8.21.0"
  },
  "exports": {
    "./application": "./src/app/application.js",
    "./application/viewer": "./src/app/viewer.js",
    "./build/vite": {
      "node": "./build/vite.js"
    },
    "./search": "./src/search/index.js",
    "./ui/panels": "./src/ui/panelDisclosure.js",
    "./ui/surfaces": "./src/ui/surfaceKeyboard.js",
    "./ui/layout": "./src/ui/panelRails.js",
    "./ui/input": "./src/ui/visualInput.js",
    "./ui/display": "./src/ui/displayControls.js",
    "./ui/effects": "./src/ui/effects.js",
    "./ui/effects/bloom": "./src/bloom.js",
    "./ui/maps": "./src/ui/mapSource.js",
    "./ui/layers": "./src/ui/layers.js",
    "./ui/layers/feedback": "./src/loadingFeedback.js",
    "./ui/location": "./src/ui/location.js",
    "./ui/scenes": "./src/ui/scenes.js",
    "./ui/shell": "./src/ui/applicationShell.js",
    "./director": "./src/director/playback.js",
    "./scenes": "./src/scenes/director.js",
    "./maps/controller": "./src/maps/controller.js",
    "./maps/catalog": "./src/maps/catalog.js",
    "./maps/imagery": "./src/maps/imagery.js",
    "./maps/terrain": "./src/maps/terrain.js",
    "./maps/3d": "./src/maps/google3d.js",
    "./maps/defaults": "./src/maps/defaultSources.js",
    "./application/scene": "./src/app/scene.js",
    "./application/controls": "./src/app/controls.js",
    "./application/data": "./src/app/data.js",
    "./application/tools": "./src/app/tools.js",
    "./application/chrome": "./src/app/startupChrome.js",
    "./application/errors": "./src/app/errors.js",
    "./ui/composition": "./src/ui/composition.js",
    "./ui/hud": "./src/hud.js",
    "./standalone/settings": "./src/keySetup.js",
    "./build/html": {
      "node": "./build/application-html.js"
    },
    "./application/catalog": "./src/app/catalog.js",
    "./standalone/catalog": "./src/standalone/catalog.js",
    "./application/layers": "./src/app/constructCatalog.js",
    "./data/lifecycle": "./src/data/lifecycle.js",
    "./ui/navigation": "./src/ui/navigationController.js",
    "./ui/share-restoration": "./src/ui/shareRestoration.js",
    "./ui/visual-settings": "./src/ui/visualSettings.js",
    "./ui/panel-chrome": "./src/ui/panelChrome.js",
    "./nexus/oil": "./src/nexus/oilGeographyLayer.ts"
  }
}
